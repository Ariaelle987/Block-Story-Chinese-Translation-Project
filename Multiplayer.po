msgid "Sign in to play online."
msgstr "登錄以在線遊玩。"

msgid "Authentication failed."
msgstr "身份驗證失敗。"

msgid "Could not get a sign-in ticket from Steam."
msgstr "無法從 Steam 獲取登錄票據。"

msgid "Steam sign-in is not available right now. You can sign in with Discord instead."
msgstr "Steam 登錄目前不可用。你可以改用 Discord 登錄。"

msgid "This Steam account does not own Block Story."
msgstr "此 Steam 賬戶未擁有 Block Story。"

msgid "This Steam account can't be used for online play."
msgstr "此 Steam 賬戶無法用於在線遊玩。"

msgid "This Block Story account is disabled."
msgstr "此 Block Story 賬戶已被禁用。"

msgid "Steam could not confirm your sign-in. Try again."
msgstr "Steam 無法確認你的登錄狀態。請重試。"

msgid "Could not reach Steam. Try again later."
msgstr "無法連接到 Steam。請稍後再試。"

msgid "Too many sign-in attempts. Wait a minute and try again."
msgstr "登錄嘗試次數過多。請等一分鐘過後重試。"

msgid "Could not reach the Block Story sign-in service."
msgstr "無法連接到 Block Story 登錄服務。"

msgid "In the Block Story Discord type /link {0} (or DM Ted-Bot: !link {0})."
msgstr "在 Block Story 的 Discord 社區中輸入 /link {0}（或私信 Ted-Bot：!link {0}）。"

msgid "The sign-in code expired. Sign in again to get a new one."
msgstr "登錄碼已過期。請重新登錄以獲取新的登錄碼。"

msgid "Your sign-in expired. Sign in again."
msgstr "你的登錄已過期。請重新登錄。"

msgid "That server address is not valid."
msgstr "該服務器地址無效。"

msgid "Sign-in is temporarily unavailable. Try again later."
msgstr "登錄暫時不可用。請稍後再試。"

msgid "Sign in to redeem codes in multiplayer."
msgstr "登錄後即可在多人遊戲中兌換兌換碼。"

msgid "Enter a code first."
msgstr "請先輸入兌換碼。"

msgid "Too many tries. Wait a minute and try again."
msgstr "嘗試次數過多。請等一分鐘後再試。"

msgid "Could not reach the Block Story code service."
msgstr "無法連接到 Block Story 兌換碼服務。"

msgid "Code redeemed!"
msgstr "兌換成功！"

msgid "That code could not be redeemed."
msgstr "該兌換碼無法兌換。"

msgid "Sign in to use cosmetics."
msgstr "登錄後即可使用裝扮。"

msgid "Signed in with Steam\nas {0}"
msgstr "已通過 Steam 登錄\n當前賬號：{0}"

msgid "Signed in with Discord\nas {0}"
msgstr "已通過 Discord 登錄\n身份：{0}"

msgid "Signing in..."
msgstr "正在登錄……"

msgid "Not signed in"
msgstr "未登錄"

msgid "Sign Out"
msgstr "離開登錄"

msgid "Sign In"
msgstr "登錄"

msgid "Your code:"
msgstr "你的登錄碼："

msgid "Getting your sign-in code..."
msgstr "正在獲取你的登錄碼……"

msgid "Signing in with Steam..."
msgstr "正在通過 Steam 登錄……"

msgid "Cancel"
msgstr "取消"

msgid "Back"
msgstr "返回"

msgid "Discord\nSign In"
msgstr "Discord\n登錄"

msgid "Try\nAgain"
msgstr "再試\n一次"

msgid "/invite: Invite Steam friends"
msgstr "/invite：邀請 Steam 好友"

msgid "Host a LAN game on Steam to invite friends"
msgstr "在 Steam 上創建局域網遊戲即可邀請好友"

msgid "The code window is not available right now."
msgstr "兌換碼窗口目前不可用。"

msgid "This server does not show that cosmetic yet. Rejoin to use newly redeemed cosmetics."
msgstr "該服務器尚未顯示該裝扮。請重新加入服務器，以使用新兌換的裝扮。"

msgid "Could not load your cosmetics."
msgstr "無法加載你的裝扮。"

msgid "You have no cosmetics yet. Redeem a cosmetic code with /redeem CODE."
msgstr "你還沒有任何裝扮。使用 /redeem CODE 來兌換裝扮兌換碼。"

msgid "Your cosmetics (use /cosmetic <name> or /cosmetic none):"
msgstr "你的裝扮（使用 /cosmetic <name> 或 /cosmetic none）："

msgid "No cosmetic shown."
msgstr "當前未顯示任何裝扮。"

msgid "Cosmetic hidden."
msgstr "裝扮已隱藏。"

msgid "Now showing {0} (it has no icon yet, so nothing appears)."
msgstr "現在顯示 {0}（它還沒有圖標，所以不會顯示任何內容）。"

msgid "Now showing {0}."
msgstr "現在顯示 {0}。"

msgid "Could not delete that LAN world."
msgstr "無法刪除那個局域網世界。"

msgid "That LAN world is being hosted right now."
msgstr "那個局域網世界目前正在託管中。"

msgid "No LAN world to host."
msgstr "沒有可託管的局域網世界。"

msgid "That LAN world is missing."
msgstr "那個局域網世界已缺失。"

msgid "LAN hosting is not available on this device."
msgstr "此設備不支持局域網託管。"

msgid "Could not start the LAN game."
msgstr "無法啟動局域網遊戲。"

msgid "Signed in as {0}."
msgstr "已以 {0} 身份登錄。"

msgid "Enter server IP and port before saving."
msgstr "儲存前請輸入服務器 IP 和端口。"

msgid "Saved {0}"
msgstr "已儲存 {0}"

msgid "Play Online"
msgstr "在線遊玩"

msgid "Online License Agreement"
msgstr "在線許可協議"

msgid "Scroll to the end of the agreement, then accept to play online."
msgstr "滾動到協議末尾，然後接受即可在線遊玩。"

msgid "Connecting to your Steam friend"
msgstr "正在連接你的 Steam 好友"

msgid "Could not reach your Steam friend"
msgstr "無法連接到你的 Steam 好友"

msgid "Enter server IP and port."
msgstr "請輸入服務器 IP 和端口。"

msgid "Server Name"
msgstr "服務器名稱"

msgid "Sign in with Discord"
msgstr "使用 Discord 登錄"

msgid "Gender"
msgstr "性別"

msgid "No image selected."
msgstr "未選擇圖片。"

msgid "Could not decode PNG."
msgstr "無法解碼 PNG。"

msgid "Skin is too large even at 64x64. Use a simpler PNG."
msgstr "皮膚即使縮小到 64x64 仍然太大。請使用更簡單的 PNG。"

msgid "Want to join\n{0}?"
msgstr "想加入\n{0}嗎？"

msgid "Join Server"
msgstr "加入服務器"

msgid "Host LAN Game"
msgstr "創建局域網遊戲"

msgid "New LAN World"
msgstr "新建局域網世界"

msgid "Host {0}\nfor up to {1} players?"
msgstr "託管 {0}\n供最多 {1} 名玩家遊玩？"

msgid "Host a LAN game\nfor up to {0} players?"
msgstr "託管局域網遊戲\n最多供 {0} 名玩家遊玩？"

msgid "Join LAN Game"
msgstr "加入局域網遊戲"

msgid "Delete {0}\nforever?"
msgstr "刪除 {0}\n且永久刪除？"

msgid "Delete LAN World"
msgstr "刪除局域網世界"

msgid "Are you sure you'd like to remove\n{0}?"
msgstr "你確定要移除\n{0}嗎？"

msgid "Remove Server"
msgstr "移除服務器"

msgid "Could not remove saved server."
msgstr "無法移除已儲存的服務器。"

msgid "No saved servers yet.\nTap Add Server to create one."
msgstr "還沒有已儲存的服務器。\n輕點“添加服務器”來創建一個。"

msgid "Steam is not running."
msgstr "Steam 未運行。"

msgid "Steam sign-in is only available in the Steam version."
msgstr "Steam 登錄僅在 Steam 版本中可用。"

msgid "Leave this game to join your Steam friend"
msgstr "離開當前遊戲，以加入你的 Steam 好友"

msgid "Copy\nCode"
msgstr "複製\n代碼"

msgid "Steam\nSign In"
msgstr "Steam\n登錄"

msgid "Save"
msgstr "儲存"

msgid "Join"
msgstr "加入"

msgid "Discord"
msgstr "Discord"

msgid "Accept"
msgstr "接受"

msgid "Decline"
msgstr "拒絕"

msgid "Add\nServer"
msgstr "添加\n服務器"

msgid "No"
msgstr "否"

msgid "Yes"
msgstr "是"

msgid "Online play uses your Discord account.\nPress Sign In to get a code, then link it in the Block Story Discord."
msgstr "在線遊玩使用你的 Discord 賬戶。\n按“登錄”獲取代碼，然後在 Block Story 的 Discord 社區中關聯。"

msgid "Online play uses your Discord or Steam account.\nPress Steam Sign In, or press Discord Sign In to get a code and link it in the Block Story Discord."
msgstr "在線遊玩使用你的 Discord 或 Steam 賬戶。\n按“Steam 登錄”，或按“Discord 登錄”獲取代碼，並在 Block Story 的 Discord 社區中關聯。"

msgid "Waiting for Discord... this screen updates by itself."
msgstr "正在等待 Discord……此界面會自動更新。"

msgid "Block Story Multiplayer is in Limited Community Testing.\nTo join the next public test, visit our Discord server."
msgstr "Block Story 多人遊戲正處於有限社區測試階段。\n要加入下一次公開測試，請訪問我們的 Discord 服務器。"

msgid "Sign in to join a server."
msgstr "登錄以加入服務器。"

msgid "Could not connect to server.\nCheck the IP and port, and make sure the server is running."
msgstr "無法連接到服務器。\n請檢查 IP 和端口，並確認服務器正在運行。"

msgid "This server is not allowed.\nChoose a different server to join."
msgstr "此服務器不被允許。\n請選擇其他服務器加入。"

msgid "WARNING Multiplayer is experimental and very unstable."
msgstr "警告：多人遊戲仍處於實驗階段，且非常不穩定。"

msgid "Add Server"
msgstr "添加服務器"

msgid "Edit Server"
msgstr "編輯服務器"

msgid "Code copied."
msgstr "代碼已複製。"

msgid "Commands:"
msgstr "命令："

msgid "/help: Show this list"
msgstr "/help：顯示此列表"

msgid "/pm user message: Private message a player"
msgstr "/pm 用戶 消息：向玩家發送私信"

msgid "/warp name: Go to a warp or server"
msgstr "/warp 名稱：前往傳送點或服務器"

msgid "/listwarps: List warp names"
msgstr "/listwarps：列出傳送點名稱"

msgid "/list: List players online"
msgstr "/list：列出在線玩家"

msgid "/redeem code: Redeem a cosmetic code"
msgstr "/redeem code：兌換裝扮兌換碼"

msgid "/cosmetic: List your cosmetics"
msgstr "/cosmetic：列出你的裝扮"

msgid "/cosmetic name: Show that cosmetic by your name"
msgstr "/cosmetic 名稱：在你的名字旁顯示該裝扮"

msgid "/cosmetic none: Hide your cosmetic"
msgstr "/cosmetic none：隱藏你的裝扮"

msgid "Could not connect to server. Check the IP and port, and make sure the server is running."
msgstr "無法連接到服務器。請檢查 IP 和端口，並確認服務器正在運行。"
